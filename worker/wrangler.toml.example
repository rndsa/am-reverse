# JANGAN commit wrangler.toml berisi kredensial.
# Salin file ini -> wrangler.toml lalu isi nilai asli (atau pakai `wrangler secret put`).

name = "am-reverse"
main = "index.js"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "../public"
binding = "ASSETS"
html_handling = "none"
not_found_handling = "single-page-application"
run_worker_first = true

[observability]
enabled = true

[[kv_namespaces]]
binding = "AM_DATA"
id = "your-kv-namespace-id"

[vars]
FIREBASE_API_KEY = "your-firebase-web-api-key"
ADMIN_PASSWORD = "set-via-wrangler-secret-put"
REQUIRE_API_KEY = "true"
