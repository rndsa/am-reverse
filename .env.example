# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Access Control
ADMIN_PASSWORD=change_this_secure_admin_password
MASTER_API_KEY=am-sk-master-key-here
REQUIRE_API_KEY=true

# Engine & Limits
RATE_LIMIT_RPM=60
AUTO_SAVE_SESSIONS=true

# Upstream Firebase & Cloud Functions (Optional overrides)
FIREBASE_API_KEY=
IDENTITY_TOOLKIT_URL=https://www.googleapis.com/identitytoolkit/v3/relyingparty
VERIFY_PURCHASE_URL=https://us-central1-alight-creative.cloudfunctions.net/verifyPurchase

# [R17] Kunci ADMIN, WAJIB dipisah dari master key.
# Dipakai untuk membuka rute /api/keys/*. Master key (MASTER_API_KEY) TIDAK bisa akses admin.
# Generate: node -e "console.log('am-adm-'+require('crypto').randomBytes(16).toString('hex'))"
ADMIN_KEY=

# [R1] Secret untuk token sesi (bikin token admin & sesi web). Generate acak.
ADMIN_SESSION_SECRET=
WEB_SESSION_SECRET=
